# API Read Access Token do TMDB. Expo inclui EXPO_PUBLIC_* no bundle mobile.
# Configure o valor real somente em .env.local, ignorado pelo Git.
EXPO_PUBLIC_TMDB_READ_TOKEN=

# URL do projeto e chave pública (anon legada ou publishable).
# Nunca usar chave secreta/privilegiada no app.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# UPCitemdb Explorer/trial: endpoint público, sem user_key.
# Opcional: sem valor usa este mesmo endpoint. Planos pagos exigirão proxy backend.
EXPO_PUBLIC_UPCITEMDB_LOOKUP_URL=https://api.upcitemdb.com/prod/trial/lookup
