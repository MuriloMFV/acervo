{
  "expo": {
    "name": "Acervo",
    "slug": "acervo",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "acervo",
    "platforms": [
      "android",
      "ios"
    ],
    "ios": {
      "supportsTablet": true
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      "expo-splash-screen",
      [
        "expo-camera",
        {
          "cameraPermission": "O Acervo usa a câmera para ler códigos de barras da sua coleção.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
